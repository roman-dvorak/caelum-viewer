# The sky drawing package is published to GitHub Packages by the caelum repo's
# release workflow. Installing it needs a token with `read:packages`:
#   NODE_AUTH_TOKEN=<token> npm install        (in GitHub Actions: ${{ secrets.GITHUB_TOKEN }})
@roman-dvorak:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN}
